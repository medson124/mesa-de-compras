# Login do sistema
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
# Chave longa e aleatória para assinar o login (gere com: python3 -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=troque-esta-chave

# Banco (Postgres na VPS). Sem esta linha usa SQLite no arquivo mesa.db
DATABASE_URL=postgresql+psycopg://mesa:SENHA@localhost:5432/mesa_compras

# IA (Anthropic). Sem a chave, o sistema funciona sem a busca/leitura com IA
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_RAPIDO=claude-haiku-5-5

# 1 em produção (HTTPS). Use 0 só para testar em http://localhost
COOKIE_SECURE=1
